[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/EndingScreen.gd" id="1_script"]

[node name="EndingScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

; 全屏背景图（由 GDScript 动态加载）
[node name="BG" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 6

; 渐变遮罩让文字可读
[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0, 0.0, 0.0, 0.60)

; 内容卡片（居中）
[node name="Card" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -340.0
offset_top = -280.0
offset_right = 340.0
offset_bottom = 280.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1
theme_override_constants/separation = 18

[node name="TagRow" type="HBoxContainer" parent="Card"]
layout_mode = 2
alignment = 1

[node name="Tag" type="Label" parent="Card/TagRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
horizontal_alignment = 1
text = "角色线"

[node name="Title" type="Label" parent="Card"]
layout_mode = 2
theme_override_font_sizes/font_size = 38
horizontal_alignment = 1
text = "结局标题"

[node name="Divider" type="HSeparator" parent="Card"]
layout_mode = 2

[node name="Text" type="RichTextLabel" parent="Card"]
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "结局文本"
autowrap_mode = 3
scroll_active = false

[node name="BtnRow" type="HBoxContainer" parent="Card"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 16

[node name="BackBtn" type="Button" parent="Card/BtnRow"]
layout_mode = 2
custom_minimum_size = Vector2(180, 50)
theme_override_font_sizes/font_size = 16
text = "  回到主菜单"

[node name="RestartBtn" type="Button" parent="Card/BtnRow"]
layout_mode = 2
custom_minimum_size = Vector2(180, 50)
theme_override_font_sizes/font_size = 16
text = "  再玩一次"
