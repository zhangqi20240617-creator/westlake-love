        "nodes": [
            {
                "id": "start",
                "text": "中考前的最后一个夜晚，你一个人走到西湖边。\n风很轻，灯很暖，湖面上有点点倒影。\n三年，在脑海里一格一格浮过来——",
                "choices": [
                    {
                        "text": "🌊 就这样站着，让记忆来",
                        "next": "memories"
                    },
                    {
                        "text": "📖 翻出之前写的日记",
                        "next": "diary"
                    },
                    {
                        "text": "📱 给最重要的人发一条消息",
                        "next": "msg_important"
                    }
                ]
            },
            {
                "id": "memories",
                "text": "初一第一天早读、那次考试失利后在走廊发呆、第一次帮人解题的成就感\n还有你记住的那些面孔——\n它们走马灯一样来了，你没有拦，也没有追。\n都是真的。",
                "effects": [
                    {
                        "type": "stat",
