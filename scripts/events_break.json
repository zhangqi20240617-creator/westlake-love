      {
        "speaker": "player",
        "text": "?",
        "choices": [
          {"text": "（走到她身边）走，今天陪你。", "affDelta": 8, "next": 3},
          {"text": "（递过一杯热奶茶）先暖暖手。", "affDelta": 6, "next": 4}
