[
    {
        "id": "vacation_park_explore",

        "location": "vacation_park",

        "repeatable": true,
        "slots": [
            "morning",
            "noon",
            "after"
        ],
        "nodes": [
            {
                "id": "start",

                "text": "公园里安静，偶尔有风吹过。\n假期的空气和上学时不一样——懒散、宽阔，像是时间放慢了脚步。",

                "choices": [
                    {
                        "text": "🌳 在大树下坐一坐",

                        "next": "tree_rest"

                    },
                    {
                        "text": "🏃 沿着湖边跑道跑步",

                        "next": "run"

                    },
                    {
                        "text": "🎧 戴着耳机发呆",

                        "next": "daydream"

                    },
                    {
                        "text": "👀 看看有没有认识的人",

                        "next": "look_around"

                    }
                ]
            },
            {
                "id": "tree_rest",

                "text": "树荫的影子一格一格移过来。\n你想了很多事情，又什么都没想。\n这种感觉不错。",

                "effects": [
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -10
                    },
                    {
                        "type": "stat",

                        "stat": "art",

                        "amount": 1
                    }
                ],
                "next": "end"

            },
            {
                "id": "run",

                "text": "跑了两圈，喘着气停在长椅旁边。\n身上热起来，脑子反而清醒了。\n假期也要保持状态。",

                "effects": [
                    {
                        "type": "stat",

                        "stat": "strength",

                        "amount": 3
                    },
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -5
                    }
                ],
                "next": "end"

            },
            {
                "id": "daydream",

                "text": "耳机里的歌单放了一首又一首。\n你想到了很多遥远的事情，又都慢慢飘散了。",

                "effects": [
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -12
                    },
                    {
                        "type": "stat",

                        "stat": "art",

                        "amount": 2
                    }
                ],
                "next": "end"

            },
            {
                "id": "look_around",

                "text": "公园里有遛狗的大爷，有推着婴儿车的阿姨，有骑着小车的孩子。\n没有你认识的人……或者说，刚好一点干扰也没有。",

                "effects": [
                    {
                        "type": "stat",

                        "stat": "social",

                        "amount": 1
                    },
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -6
                    }
                ],
                "next": "end"

            },
            {
                "id": "end",

                "text": "（假期就应该这样浪费。）",

                "isEnd": true
            }
        ]
    },
    {
        "id": "vacation_park_char_meet",

        "location": "vacation_park",

        "repeatable": false,
        "requireFav": {
            "any": 40
        },
        "slots": [
            "afternoon",
            "after"
        ],
        "nodes": [
            {
                "id": "start",

                "text": "公园湖边的长椅旁，你看到了一个熟悉的背影——\n她/他好像在发呆，没注意到你走过来。",

                "choices": [
                    {
                        "text": "👋 走过去打招呼",

                        "next": "greet"

                    },
                    {
                        "text": "😶 绕开，不打扰",

                        "next": "avoid"

                    }
                ]
            },
            {
                "id": "greet",

                "text": "\"……啊，是你。\"\n她/他转过来，有些意外，但眼神里有一种放松的亮度。\n\"你也来这里。\"\n两个人就这么并排坐着，说了很久的话，也有很长时间什么都没说。",

                "effects": [
                    {
                        "type": "favorBest",

                        "amount": 6
                    },
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -8
                    },
                    {
                        "type": "setFlag",

                        "flag": "vacation_park_meet_done"

                    }
                ],
                "next": "end"

            },
            {
                "id": "avoid",

                "text": "你绕过去，没有打扰她/他。\n独处的人大概也需要自己的空间。",

                "effects": [
                    {
                        "type": "stat",

                        "stat": "stress",

                        "amount": -5
                    },
                    {
                        "type": "setFlag",

                        "flag": "vacation_park_meet_done"

                    }
                ],
                "next": "end"

            },
            {
                "id": "end",

                "text": "（假期的相遇，没有作业和考试的背景，感觉格外不同。）",

                "isEnd": true
            }
        ]
    },
    {
        "id": "part_time_apply",

        "location": "part_time_job",

        "repeatable": false,
        "excludeFlags": [
            "flag_has_parttime_job"
