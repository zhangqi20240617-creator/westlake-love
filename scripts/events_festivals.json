        "nodes": [
            {
                "id": "start",
                "text": "端午节，学校放了半天假。\n西湖边的龙舟赛早就结束了，但湖面上还有几艘船在慢悠悠地划。\n有人在岸边卖粽子，糯米味飘得很远。",
                "choices": [
                    {
                        "text": "🍃 买个粽子吃",
                        "next": "eat_zongzi"
