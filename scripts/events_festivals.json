    {
        "id": "fest_midautumn",
        "location": "west_lake",
        "slots": [
            "evening"
        ],
        "manual_only": true,
        "repeatable": false,
        "nodes": [
            {
                "id": "start",
                "text": "中秋节夜晚，西湖边的人比平时多了几倍。\n月亮挂在湖上方，又圆又亮，倒影铺开来，像是另一个月亮沉在水里。",
                "choices": [
                    {
                        "text": "🥮 吃月饼赏月",
                        "next": "eat_mooncake"
                    },
                    {
                        "text": "🎑 在湖边坐很久",
                        "next": "sit_by_lake"
                    },
                    {
                        "text": "📞 打电话回家",
                        "next": "call_home"
                    }
                ]
            },
            {
                "id": "eat_mooncake",
                "text": "你买了一块蛋黄莲蓉，坐在苏堤边上吃。\n月饼很甜，甜得有点腻，你还是一口气吃完了。\n头顶的月亮，和去年一样大——你却觉得自己小了一点。",
                "effects": [
                    {
                        "type": "stat",
                        "stat": "stress",
                        "amount": -10
                    },
                    {
                        "type": "money",
                        "amount": -10
                    },
                    {
                        "type": "setFlag",
